{
  "name": "suburbmates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:test": "tsx --env-file=.env.local scripts/test-seed-policy.ts",
    "claim:test": "tsx --env-file=.env.local scripts/test-claims.ts",
    "start": "wrangler dev",
    "audit": "tsx --env-file=.env.local scripts/audit-vendor-candidates.ts",
    "audit:test": "tsx --env-file=.env.local scripts/test-audit.ts",
    "acquire:osm": "tsx --env-file=.env.local scripts/acquire-openstreetmap.ts",
    "acquire:osm:test": "tsx --env-file=.env.local scripts/test-acquire-openstreetmap.ts",
    "catalogue:merge": "tsx --env-file=.env.local scripts/merge-vendor-catalogues.ts",
    "catalogue:merge:test": "tsx --env-file=.env.local scripts/test-merge-vendor-catalogues.ts",
    "catalogue:report": "tsx scripts/report-catalogue-coverage.ts",
    "verify:db": "tsx --env-file=.env.local scripts/verify-db.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/mcp-server-supabase": "^0.8.2",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.29.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "tldts": "^7.4.8"
  }
}
